{
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "destination": "https://flowforce.tec.br/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],
  "crons": [
    {
      "path": "/api/clt-cron-followups",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/sofia-cron-followups",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/clt-cron-reconsulta",
      "schedule": "*/15 10-11 26 6 *"
    }
  ]
}
